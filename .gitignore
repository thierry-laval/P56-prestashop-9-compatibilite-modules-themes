# Éditeurs et IDE
.idea/
.vscode/

# Archives et paquets distribués
*.zip

# Dépendances et artefacts intermédiaires de l'interface web
web/node_modules/
web/dist/
web/.vite/
# Copies générées au build par web/scripts/sync-assets.mjs (avant émission)
web/public/php/
web/public/img/

# NB : le dossier docs/ est le build PUBLIÉ par GitHub Pages
# (Settings > Pages > Branch: main / folder: /docs). Il est volontairement
# VERSIONNÉ ici : GitHub Pages ne sert que du statique et n'exécute aucun build.
# Régénérez-le avec "cd web && npm run build" puis committez docs/.

# Cache du scanner
.ps9compatible-cache/

# macOS
.DS_Store
._*
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Desktop.ini

